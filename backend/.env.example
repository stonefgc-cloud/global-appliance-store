# Environment Configuration Template
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000

# Stripe Payment Gateway
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Email Configuration (Nodemailer)
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Contact Email (Where to receive contact form submissions)
CONTACT_EMAIL=support@globalappliance.com

# Optional: Database Connection (For production use)
# MONGODB_URI=mongodb://localhost:27017/global-appliance
# DATABASE_URL=postgresql://user:password@localhost:5432/global_appliance
